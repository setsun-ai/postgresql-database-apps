# Connection settings read by the apps (standard libpq variable names).
# Copy to .env (git-ignored) or export them in your shell. Never put a real password here.
PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel
PGUSER=hotel_app
# PGPASSWORD is optional: the apps ask for the password interactively when it is not set.
# Prefer ~/.pgpass (chmod 600) over keeping a password in the environment.
